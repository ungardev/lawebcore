# =================================================================
# La Web Core - .gitignore
# =================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo
# Vite build artifacts (emitted by tsc -b on vite.config.ts)
apps/web/vite.config.js
apps/web/vite.config.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/

# Environments
.env
.env.local
.env.*.local
!.env.example
*.env

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor / IDE
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Supabase
supabase/.branches
supabase/.temp

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# Misc
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Secrets
*.pem
*.key
*.crt
service-account*.json
gcp-key.json
secrets/
.gcp/

# Data dumps
*.dump
*.sql.gz

# Sensitive data exports
*.png
dataset_*.json
*.xlsx
apify_token.png

# Generated types (will be committed selectively)
packages/shared-types/src/api-generated.ts.bak
.vercel
.env*

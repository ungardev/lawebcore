# =================================================================
# La Web Core - Environment variables template
# Copiar a .env y rellenar con valores reales
# =================================================================

# ---------- Railway PostgreSQL ----------
# Primary: Railway PostgreSQL connection string
POSTGRES_URL=postgresql://postgres:<password>@postgres.railway.internal:5432/railway
# Legacy alias (deprecated — use POSTGRES_URL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_SERVICE_KEY=

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres:<password>@postgres.railway.internal:5432/railway

# ---------- Backend API ----------
API_ENV=development
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://lawebcore.vercel.app"]

# ---------- Admin ----------
ADMIN_TOKEN=laweb-admin-token-2026  # Cambiar en produccion

# ---------- Redis (Railway add-on) ----------
ARQ_REDIS_URL=redis://localhost:6379/0

# ---------- Frontend (Vercel) ----------
VITE_API_URL=http://localhost:8000

# ---------- AI - DeepSeek ----------
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- P.I.A.R. Discovery Module ----------
# HikerAPI (https://api.hikerapi.com) — Instagram discovery (default)
HIKERAPI_API_KEY=
INSTAGRAM_SOURCE=hikerapi  # hikerapi | apify | hybrid

# LENS Budget & Cost Controls
MONTHLY_BUDGET_USD=10.0
MAX_CALLS_PER_RUN=120
BUDGET_ALERT_THRESHOLD=0.7
HIKERAPI_COST_PER_CALL_USD=0.0006
HIKERAPI_5XX_BREAKER_THRESHOLD=5
HIKERAPI_5XX_BREAKER_TTL_S=300

# Apify (https://apify.com) — fallback for TikTok/YouTube
APIFY_API_KEY=

# Meta Business API (https://developers.facebook.com)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# TikTok Research API (https://research.tiktok.com)
TIKTOK_RESEARCH_API_KEY=

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_DATA_API_KEY=

# Metricool (https://metricool.com)
METRICOOL_CLIENT_ID=
METRICOOL_CLIENT_SECRET=
METRICOOL_ACCESS_TOKEN=

# HypeAuditor (https://hypeauditor.com)
HYPEAUDITOR_API_KEY=

# ---------- Local scripts (not Railway) ----------
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=

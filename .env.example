# =================================================================
# La Web Core - Environment variables template
# Copiar a .env y rellenar con valores reales
# =================================================================

# ---------- Supabase ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>     # SERVER ONLY - never expose
SUPABASE_JWT_SECRET=<jwt-secret>                 # for verifying tokens

# ---------- Database (direct connection) ----------
DATABASE_URL=postgresql+asyncpg://postgres:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ---------- Backend API ----------
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- Redis (Railway add-on) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Workers ----------
ARQ_REDIS_URL=redis://localhost:6379/0

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
VITE_APP_NAME="La Web Core"

# ---------- AI Providers ----------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

# ---------- Integrations ----------
HYPEAUDITOR_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
TRELLO_API_KEY=
TRELLO_TOKEN=
SLACK_WEBHOOK_URL=

# ---------- P.I.A.R. Discovery Module ----------
# Apify (https://apify.com) — scraping Instagram, TikTok, YouTube
APIFY_API_KEY=

# Meta Business API (https://developers.facebook.com)
# 1. Crear app en developers.facebook.com
# 2. Solicitar permisos: instagram_basic, pages_read_engagement, instagram_graph_user_media
# 3. Obtener Page access token via OAuth flow
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# TikTok Research API (https://research.tiktok.com)
# Requiere solicitud formal (7-15 días). Gratis para investigación de mercado.
TIKTOK_RESEARCH_API_KEY=

# YouTube Data API v3 (https://console.cloud.google.com)
# 10,000 units/día gratis. Crear proyecto en Google Cloud Console.
YOUTUBE_DATA_API_KEY=

# Metricool (https://metricool.com) — Plan Agency $25/mes para API completa
METRICOOL_CLIENT_ID=
METRICOOL_CLIENT_SECRET=
METRICOOL_ACCESS_TOKEN=

# ---------- Storage ----------
SUPABASE_STORAGE_BUCKET=lawebcore-assets

# ---------- Feature flags ----------
FEATURE_AI_ASSISTANT=true
FEATURE_KANBAN=true
FEATURE_WORKFLOWS=true
FEATURE_REPORTS_AUTO=true
FEATURE_DISCOVERY=true